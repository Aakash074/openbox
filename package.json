{
  "name": "openbox",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build",
    "test:contracts": "cd contracts && forge test -vvv",
    "dev:local": "node scripts/dev-local.mjs",
    "e2e:local": "tsx scripts/e2e-local.ts",
    "typecheck": "pnpm -r typecheck",
    "dev:testnet": "node scripts/dev-testnet.mjs",
    "live:order": "tsx scripts/testnet/live-order.ts",
    "start:hosted": "node scripts/render-start.mjs"
  },
  "devDependencies": {
    "@openbox/hedera": "workspace:^",
    "@openbox/shared": "workspace:^",
    "@types/node": "^22.20.5",
    "@x402/core": "^2.29.0",
    "@x402/fetch": "^2.29.0",
    "@x402/hedera": "^2.29.0",
    "dotenv": "^18.0.9",
    "jose": "^6.2.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "viem": "^2.57.0"
  }
}
