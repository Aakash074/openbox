.hedera-mock
# local Anvil deployment (redeployed by `pnpm dev:local`)
deployments/31337.json
contracts/broadcast/*/31337
# Foundry dry runs and timestamped duplicates of run-latest.json
contracts/broadcast/**/dry-run
contracts/broadcast/**/run-[0-9]*.json

# ---- tool-generated files ----------------------------------------------------------
# written and re-added by `next dev` (instructions for AI coding tools)
apps/web/AGENTS.md
apps/web/CLAUDE.md
.claude/
*.log

