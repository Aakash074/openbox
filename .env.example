# ============================================================================
# OpenBox environment. Copy to .env. Defaults below run fully local (Anvil + mocks).
# Keys below are Anvil's public, well-known dev keys: NEVER use them on a real network.
# ============================================================================

# ---- Chain -------------------------------------------------------------------
# 31337 = local Anvil (MockUSDT). 1874 = Whitechain Sepolia (official USDT only).
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# Whitechain Sepolia: RPC_URL=https://rpc.testnet.whitechain.io
# WHITECHAIN_EXPLORER=https://<testnet explorer, confirm in hour-1 test 2>
# WHITECHAIN_VERIFIER=blockscout
# WHITECHAIN_VERIFIER_URL=https://<explorer>/api
# USDT_ADDR=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7   # required on 1874

# ---- Keys (EVM) --------------------------------------------------------------
DEPLOYER_PK=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Merchant relayer: pays WBT gas for buyers, couriers and the household agent
RELAYER_PK=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# Backend key that co-signs courier attestations after validating World checks
ATTESTER_PK=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
ATTESTER_ADDR=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
# Demo merchant / seller signing key (production: merchant's own server)
SELLER_PK=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
# Inspection services' verdict keys (both registered on DeliveryCheckout)
INSPECTOR_PK=0x47e179ec197488593b187f80a00eb0da91f1b9d0b13f8733639f19c30a34926a
INSPECTOR2_PK=0x8b3a350cf5c34c9194ca85829a2df0ec3153be0318b5e2d3348e872092edffba
INSPECTOR_ADDRS=0x15d34AAf54267DB7D7c367839AAf71A00a2C6A65,0x9965507D1a55bcC2695C58ba16FB37d819B0A4dc
# Demo lender: buys tokenized invoices (ReceivableNote); allowlisted at deploy
DEMO_LENDER_PK=0x92db14e403b83dfe3df233f83dfa3a0d7096f21ca9b0d6d6b8d88b2b4ec1564e
LENDER_ADDR=0x976EA74026E726554dB657fA54763abd0C3a0aa9
# Optional on 1874: wallet holding official USDT to fund demo buyer wallets (DEMO_MODE only)
# DEMO_TREASURY_PK=

# ---- Checkout ----------------------------------------------------------------
# permit | eip3009 | account. Verified 2026-11-04: official USDT on 1874 supports EIP-3009 (+ permit), domain {"Tether USD","1"}
GASLESS_MODE=eip3009
DEMO_MODE=true
INSPECTION_WINDOW_S=120
DELIVERY_WINDOW_S=259200
RETURN_WINDOW_S=604800
MERCHANT_SECRET_KEY=sk_demo_openbox
MERCHANT_PUBLISHABLE_KEY=pk_demo_openbox
DEMO_STORE_WEBHOOK_URL=http://localhost:5174/webhooks/openbox
DEMO_STORE_WEBHOOK_SECRET=whsec_demo_openbox

# ---- Relayer drain protection -------------------------------------------------
RELAYER_MAX_GAS_PER_TX=1500000
RELAYER_DAILY_BUDGET_WEI=50000000000000000
RELAYER_PER_IP_PER_MIN=20
RELAYER_PER_WALLET_PER_HOUR=10

# ---- World ID Agent Pass ------------------------------------------------------
# mock | agentpass
WORLD_MODE=mock
WORLD_ISSUER=https://auth.world.org
# WORLD_CLIENT_ID=
# WORLD_CLIENT_SECRET=
WORLD_REQUEST_TTL_S=300

# ---- Household agent (x402 client on Hedera) ----------------------------------
# mock | live
HEDERA_MODE=mock
HEDERA_NETWORK=hedera:testnet
HEDERA_USDC_TOKEN_ID=0.0.429274
# HEDERA_AGENT_ACCOUNT_ID=0.0.x
# HEDERA_AGENT_PRIVATE_KEY=0x...
# Inspectors are discovered from the HCS "inspectors" topic (Mirror Node). Allowlist = inspector keys or URLs
# (empty = any inspector whose key is registered on DeliveryCheckout)
AGENT_INSPECTOR_ALLOWLIST=0x15d34AAf54267DB7D7c367839AAf71A00a2C6A65,0x9965507D1a55bcC2695C58ba16FB37d819B0A4dc
AGENT_MAX_PRICE_PER_CALL=0.10
AGENT_APPROVAL_THRESHOLD=0.25
AGENT_DAILY_BUDGET=2

# ---- Inspector (x402 server) ---------------------------------------------------
INSPECTOR_PORT=4100
INSPECTOR_PRICE_USD=0.05
# Hedera account that receives inspection fees (must be associated with USDC)
INSPECTOR_PAY_TO=0.0.9002
# Listed facilitator (e.g. https://api.testnet.blocky402.com, https://x402.org/facilitator) or our own:
X402_FACILITATOR_URL=http://localhost:4200
# mock | anthropic | openai | gemini   (switchable any time)
VISION_PROVIDER=mock
# VISION_MODEL=claude-opus-5-5
# VISION_EFFORT=low
# ANTHROPIC_API_KEY= / OPENAI_API_KEY= / GEMINI_API_KEY=
# HCS topics (created by: pnpm --filter @openbox/hedera exec tsx scripts/setup-testnet.ts). Unset = local mock topics in .hedera-mock/
# HCS_INSPECTORS_TOPIC_ID=0.0.x
# HCS_LOG_TOPIC_ID=0.0.x
# Inspector Hedera operator (writes directory entry + verdict log)
# HEDERA_INSPECTOR_ACCOUNT_ID=0.0.x
# HEDERA_INSPECTOR_PRIVATE_KEY=0x...
# Second inspector (dev-local starts it on :4101 with a higher price)
INSPECTOR2_PRICE_USD=0.30
INSPECTOR2_PAY_TO=0.0.9003
DAMAGE_MINOR_BPS=1500
DAMAGE_MAJOR_BPS=5000

# ---- Fallback facilitator -------------------------------------------------------
# mock | live
FACILITATOR_MODE=mock
FACILITATOR_PORT=4200
# HEDERA_FACILITATOR_ACCOUNT_ID=0.0.x
# HEDERA_FACILITATOR_PRIVATE_KEY=0x...

# ---- Ports / URLs -----------------------------------------------------------------
BACKEND_PORT=4000
BACKEND_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Testnet: shrink demo prices (20 -> 6 / 2 / 4.5 USDT) and demo top-ups
# CATALOG_DIVISOR=1
# DEMO_FUND_USDT=200
